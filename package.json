{
  "name": "bingo-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Bingo Platform monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api",
    "typecheck": "npm run typecheck -w apps/api",
    "lint": "npm run lint -w apps/api",
    "test": "npm run test -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:deploy": "npm run db:deploy -w apps/api",
    "db:studio": "npm run db:studio -w apps/api",
    "openapi:export": "npm run openapi:export -w apps/api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^26.6.5",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
