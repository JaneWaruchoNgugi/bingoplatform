# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bingo_dev
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Dev-only admin auth token — used by x-mock-admin-token header.
# Only accepted when NODE_ENV != production.
# Replace with real auth adapter integration before going live.
ADMIN_SECRET=dev-admin-secret
